{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/reconcile.py\"",
            "statusMessage": "Checking codexskills profiles"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(^|[.:])spawn_agent$|^collaborationspawn_agent$|^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/check_delegation.py\"",
            "timeout": 10,
            "statusMessage": "Checking delegation model and effort"
          }
        ]
      }
    ]
  }
}
